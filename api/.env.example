# Copia este archivo como .env y rellena tus credenciales de Supabase
# Encuéntralas en: Supabase → Settings → Database → Connection string → URI

DATABASE_URL=postgresql://postgres.[TU_PROJECT_REF]:[TU_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Puerto donde correrá FastAPI localmente
API_PORT=8000

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3001
