# Copia este archivo como api/.env y rellena los valores.
# api/.env está en .gitignore: NUNCA lo subas al repositorio.

# ── Supabase (Supabase → Project Settings → API) ─────────────────────────────
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=TU_CLAVE

# ── Inicio de sesión administrativo ──────────────────────────────────────────
# Genera estos tres valores con:  python crear_admin.py
ADMIN_USER=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
# Minutos que dura la sesión (opcional, por defecto 60)
AUTH_TTL_MIN=60

# ── CORS (opcional) ──────────────────────────────────────────────────────────
# Orígenes adicionales del frontend, separados por coma
FRONTEND_ORIGINS=
